EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Destinations for the "About" and "Portfolio" words in the footer credit line.
# Leave a value unset and the word still prints — it just is not a link, which
# is what ships until the pages exist. Set the EXPO_ pair for the app and the
# NEXT_ pair for the site; both are inlined at build time, so a change needs a
# rebuild.
EXPO_PUBLIC_ABOUT_URL=
EXPO_PUBLIC_PORTFOLIO_URL=
NEXT_PUBLIC_ABOUT_URL=
NEXT_PUBLIC_PORTFOLIO_URL=
