const SHEET_COLUMNS = 5;
const SHEET_ROWS = 6;
const PLAYER_GRID_GAP = 10;
const PLAYER_GRID_COLUMNS = 3;
const PLAYER_CARD_WIDTH =
  (SCREEN_WIDTH - 16 - 16 - 12 - PLAYER_GRID_GAP * (PLAYER_GRID_COLUMNS - 1)) / PLAYER_GRID_COLUMNS;
const PLAYER_CARD_HEIGHT = PLAYER_CARD_WIDTH * 1.42;

type HomeTab = "Game" | "Leaderboard" | "Navigation";

type PlayerLike = {
  id: string;
  name: string;
  color?: string;
  initials?: string;
  assignedCardArtIndex?: number | null;
  elo?: number;
  rating?: number;
  wins?: number;
  gamesPlayed?: number;
  totalPrestige?: number;
  prestige?: number;
  directPrestige?: number;
  assistPrestigeReceived?: number;
  contracts?: number;
  assists?: number;
  failures?: number;
  score?: number;
  stats?: {
    wins?: number;
    gamesPlayed?: number;
    totalPrestige?: number;
    prestige?: number;
    directPrestige?: number;
    assistPrestigeReceived?: number;
    contracts?: number;
    assists?: number;
    failures?: number;
    score?: number;
  };
};

type GroupLike = {
  id: string;
  name: string;
  playerIds?: string[];
  createdAt?: number;
};

type GameTotals = {
  prestige?: number;
  totalPrestige?: number;
  directPrestige?: number;
  assistPrestigeReceived?: number;
  contracts?: number;
  assists?: number;
  failures?: number;
  score?: number;
  elo?: number;
  rating?: number;
};

type GameLike = {
  id?: string;
  players?: Array<{ id?: string; playerId?: string }>;
  totals?: Record<string, GameTotals>;
  winnerId?: string;
  selectedWinnerId?: string;
  manualWinnerId?: string;
  createdAt?: number;
};

type SortMetric =
  | "totalPrestige"
  | "score"
  | "elo"
  | "winRate"
  | "efficiency"
  | "assistPrestige"
  | "directPrestige";

type EnrichedPlayer = {
  player: PlayerLike;
  elo: number;
  gamesPlayed: number;
  wins: number;
  totalPrestige: number;
  directPrestige: number;
  assistPrestigeReceived: number;
  totalContracts: number;
  totalAssists: number;
  totalFailures: number;
  totalScore: number;
  winRate: number;
  efficiency: number;
};

const SORT_OPTIONS: { key: SortMetric; shortLabel: string }[] = [
  { key: "totalPrestige", shortLabel: "Prestige" },
  { key: "score", shortLabel: "Score" },
  { key: "elo", shortLabel: "ELO" },
  { key: "winRate", shortLabel: "Win %" },
  { key: "efficiency", shortLabel: "Eff" },
  { key: "directPrestige", shortLabel: "Direct" },
  { key: "assistPrestige", shortLabel: "Assist" },
];

function toNumber(value: unknown): number {
  return typeof value === "number" && Number.isFinite(value) ? value : 0;
}

function safeDivide(numerator: number, denominator: number) {
  return denominator > 0 ? numerator / denominator : 0;
}

function getWinnerId(game?: GameLike): string | undefined {
  if (!game) return undefined;
  return game.winnerId ?? game.selectedWinnerId ?? game.manualWinnerId;
}

function getPlayerColor(color?: string) {
  switch ((color ?? "").toLowerCase()) {
    case "green":
      return "#22C55E";
    case "purple":
      return "#A855F7";
    case "blue":
      return "#3B82F6";
    case "orange":
      return "#F97316";
    case "yellow":
      return "#EAB308";
    case "red":
      return "#EF4444";
    case "pink":
      return "#EC4899";
    default:
      return "#94A3B8";
  }
}

function getPlayerTint(color?: string) {
  switch ((color ?? "").toLowerCase()) {
    case "green":
      return "rgba(34,197,94,0.16)";
    case "purple":
      return "rgba(168,85,247,0.16)";
    case "blue":
      return "rgba(59,130,246,0.16)";
    case "orange":
      return "rgba(249,115,22,0.16)";
    case "yellow":
      return "rgba(234,179,8,0.16)";
    case "red":
      return "rgba(239,68,68,0.16)";
    case "pink":
      return "rgba(236,72,153,0.16)";
    default:
      return "rgba(148,163,184,0.12)";
  }
}

function cropPosition(index: number) {
  return {
    row: Math.floor(index / SHEET_COLUMNS),
    col: index % SHEET_COLUMNS,
  };
}

function CropCardArt({
  artIndex,
  width,
  height,
}: {
  artIndex: number;
  width: number;
  height: number;
}) {
  const { row, col } = cropPosition(artIndex);

  
// ===== START GAME STATE =====
const canStartGame =
  (selectedPlayers?.length ?? 0) >= 2 ||
  Boolean(selectedGroupId);


    <View style={[styles.cropWindow, { width, height }]}>
      <Image
        source={SHEET}
        resizeMode="stretch"
        style={{
          position: "absolute",
          width: width * SHEET_COLUMNS,
          height: height * SHEET_ROWS,
          left: -(col * width),
          top: -(row * height),
        }}
      />
    </View>
  );
}

function formatPercent(value: number) {
  return `${Math.round(value * 100)}%`;
}

function formatMetric(metric: SortMetric, value: number) {
  switch (metric) {
    case "winRate":
      return formatPercent(value);
    case "efficiency":
      return value.toFixed(2);
    case "elo":
    case "score":
    case "assistPrestige":
    case "directPrestige":
    case "totalPrestige":
    default:
      return `${Math.round(value)}`;
  }
}

function getSortValue(entry: EnrichedPlayer, sortBy: SortMetric): number {
  switch (sortBy) {
    case "elo":
      return entry.elo;
    case "score":
      return entry.totalScore;
    case "winRate":
      return entry.winRate;
    case "efficiency":
      return entry.efficiency;
    case "assistPrestige":
      return entry.assistPrestigeReceived;
    case "directPrestige":
      return entry.directPrestige;
    case "totalPrestige":
    default:
      return entry.totalPrestige;
  }
}

function getRankAccent(index: number) {
  if (index === 0) return COLORS.amber;
  if (index === 1) return "#D9E4F7";
  if (index === 2) return "#D6A06A";
  return COLORS.accent;
}

function getPlayerStatsFromGames(player: PlayerLike, games: GameLike[]) {
  let gameGamesPlayed = 0;
  let gameWins = 0;
  let gameTotalPrestige = 0;
  let gameDirectPrestige = 0;
  let gameAssistPrestigeReceived = 0;
  let gameTotalContracts = 0;
  let gameTotalAssists = 0;
  let gameTotalFailures = 0;
  let gameTotalScore = 0;
  let latestElo = toNumber(player.elo ?? player.rating ?? 1000);

  for (const game of games) {
    const totals = game.totals?.[player.id];
    if (!totals) continue;

    gameGamesPlayed += 1;

    const direct = toNumber(totals.directPrestige);
    const assist = toNumber(totals.assistPrestigeReceived);
    const total =
      typeof totals.totalPrestige === "number" && Number.isFinite(totals.totalPrestige)
        ? totals.totalPrestige
        : typeof totals.prestige === "number" && Number.isFinite(totals.prestige)
          ? totals.prestige
          : direct + assist;

    gameTotalPrestige += total;
    gameDirectPrestige += direct;
    gameAssistPrestigeReceived += assist;
    gameTotalContracts += toNumber(totals.contracts);
    gameTotalAssists += toNumber(totals.assists);
    gameTotalFailures += toNumber(totals.failures);
    gameTotalScore += toNumber(totals.score);

    latestElo = toNumber(totals.elo ?? totals.rating ?? latestElo);

    if (getWinnerId(game) === player.id) {
      gameWins += 1;
    }
  }

  const savedGamesPlayed = toNumber(player.stats?.gamesPlayed ?? player.gamesPlayed);
  const savedWins = toNumber(player.stats?.wins ?? player.wins);
  const savedDirect = toNumber(player.stats?.directPrestige ?? player.directPrestige);
  const savedAssist = toNumber(player.stats?.assistPrestigeReceived ?? player.assistPrestigeReceived);
  const savedTotal =
    typeof player.stats?.totalPrestige === "number"
      ? player.stats.totalPrestige
      : typeof player.totalPrestige === "number"
        ? player.totalPrestige
        : typeof player.stats?.prestige === "number"
          ? player.stats.prestige
          : typeof player.prestige === "number"
            ? player.prestige
            : savedDirect + savedAssist;

  const savedContracts = toNumber(player.stats?.contracts ?? player.contracts);
  const savedAssists = toNumber(player.stats?.assists ?? player.assists);
  const savedFailures = toNumber(player.stats?.failures ?? player.failures);
  const savedScore = toNumber(player.stats?.score ?? player.score);

  const gamesPlayed = gameGamesPlayed > 0 ? gameGamesPlayed : savedGamesPlayed;
  const wins = gameGamesPlayed > 0 || gameWins > 0 ? gameWins : savedWins;
  const totalPrestige = gameTotalPrestige > 0 ? gameTotalPrestige : savedTotal;
  const directPrestige = gameDirectPrestige > 0 ? gameDirectPrestige : savedDirect;
  const assistPrestigeReceived =
    gameAssistPrestigeReceived > 0
      ? gameAssistPrestigeReceived
      : savedAssist > 0
        ? savedAssist
        : Math.max(0, totalPrestige - directPrestige);

  const totalContracts = gameTotalContracts > 0 ? gameTotalContracts : savedContracts;
  const totalAssists = gameTotalAssists > 0 ? gameTotalAssists : savedAssists;
  const totalFailures = gameTotalFailures > 0 ? gameTotalFailures : savedFailures;
  const totalScore = gameTotalScore > 0 ? gameTotalScore : savedScore;

  return {
    elo: latestElo || 1000,
    gamesPlayed,
    wins,
    totalPrestige,
    directPrestige,
    assistPrestigeReceived,
    totalContracts,
    totalAssists,
    totalFailures,
    totalScore,
    winRate: safeDivide(wins, gamesPlayed),
    efficiency: safeDivide(directPrestige + assistPrestigeReceived, totalContracts + totalAssists),
  };
}

