          />
        ))}
      </View>
    </Pressable>
  );
}

export default function HomeScreen() {
  const router = useRouter();
  const pathname = usePathname();

  const players = useStore((s: any) => (Array.isArray(s.players) ? s.players : [])) as PlayerLike[];
  const groups = useStore((s: any) => (Array.isArray(s.groups) ? s.groups : [])) as GroupLike[];
  const games = useStore((s: any) => (Array.isArray(s.games) ? s.games : [])) as GameLike[];
  const activeGame = useStore((s: any) => s.activeGame);
  const clearActiveGame = useStore((s: any) => s.clearActiveGame);
  const assignPlayerCard = useStore((s: any) => s.assignPlayerCard);

  const [activeTab, setActiveTab] = useState<HomeTab>("Game");
  const [selectedGroupId, setSelectedGroupId] = useState<string | null>(null);
  const [manualSelectedPlayerIds, setManualSelectedPlayerIds] = useState<string[]>([]);
  const [leaderboardSort, setLeaderboardSort] = useState<SortMetric>("totalPrestige");
  const [showAllLeaderboard, setShowAllLeaderboard] = useState(false);
  const [selectedLeaderboardPlayerId, setSelectedLeaderboardPlayerId] = useState<string | null>(null);

  useEffect(() => {
    ensurePlayersHaveAssignedCards(players, assignPlayerCard);
  }, [players, assignPlayerCard]);

  const selectedGroup = useMemo(
    () => groups.find((group) => group.id === selectedGroupId) ?? null,
    [groups, selectedGroupId]
  );

  const activeSelectedPlayerIds = useMemo(() => {
    if (selectedGroup && Array.isArray(selectedGroup.playerIds)) {
      return selectedGroup.playerIds.filter(Boolean);
    }
    return manualSelectedPlayerIds;
  }, [manualSelectedPlayerIds, selectedGroup]);

  const selectedPlayers = useMemo(() => {
    const ids = new Set(activeSelectedPlayerIds);
    return players.filter((player) => ids.has(player.id));
  }, [players, activeSelectedPlayerIds]);

  const enrichedPlayers = useMemo<EnrichedPlayer[]>(() => {
    return players.map((player) => {
      const stats = getPlayerStatsFromGames(player, games);
      return {
        player,
        ...stats,
      };
    });
  }, [players, games]);

  const rankedPlayers = useMemo(() => {
    return [...enrichedPlayers]
      .filter(
        (entry) =>
          entry.gamesPlayed > 0 ||
          entry.totalPrestige > 0 ||
          entry.totalScore > 0 ||
          entry.wins > 0
      )
      .sort((a, b) => {
        const primaryDiff = getSortValue(b, leaderboardSort) - getSortValue(a, leaderboardSort);
        if (primaryDiff !== 0) return primaryDiff;
        if (b.totalPrestige !== a.totalPrestige) return b.totalPrestige - a.totalPrestige;
        if (b.totalScore !== a.totalScore) return b.totalScore - a.totalScore;
        if (b.winRate !== a.winRate) return b.winRate - a.winRate;
        if (b.elo !== a.elo) return b.elo - a.elo;
        return a.player.name.localeCompare(b.player.name);
      });
  }, [enrichedPlayers, leaderboardSort]);

  const visibleRankedPlayers = useMemo(
    () => (showAllLeaderboard ? rankedPlayers : rankedPlayers.slice(0, 10)),
    [rankedPlayers, showAllLeaderboard]
  );

  const manualReady = manualSelectedPlayerIds.length >= 2;
  const groupReady = !!selectedGroup && (selectedGroup.playerIds?.length ?? 0) >= 2;
  const canStart = manualReady || groupReady;

  const startButtonLabel = useMemo(() => {
    if (selectedGroup?.name) return `Launch ${selectedGroup.name}`;
    if (manualSelectedPlayerIds.length >= 2) return `Launch ${manualSelectedPlayerIds.length}-Player Game`;
    return "Select 2+ Players";
  }, [manualSelectedPlayerIds.length, selectedGroup]);

  const orderedGroups = useMemo(() => {
    return [...groups].sort((a, b) => toNumber(b.createdAt) - toNumber(a.createdAt));
  }, [groups]);

  const toggleSelectedPlayer = (playerId: string) => {
    setSelectedGroupId(null);
    setManualSelectedPlayerIds((current) =>
      current.includes(playerId)
        ? current.filter((id) => id !== playerId)
        : [...current, playerId]
    );
  };

  const handleSelectGroup = (group: GroupLike) => {
    setSelectedGroupId(group.id);
    setManualSelectedPlayerIds([]);
  };

  const handleStartGame = () => {
    if (!canStart) {
      Alert.alert("Not ready", "Select at least 2 players or choose a saved group.");
      return;
    }

    router.push({
      pathname: "/game-setup",
      params: {
        playerIds: JSON.stringify(activeSelectedPlayerIds),
        groupId: selectedGroup?.id,
        groupName: selectedGroup?.name,
      },
    });
  };

  const handleContinueGame = () => {
    if (!activeGame) return;
    router.push("/game");
  };

  const handleDeleteActiveGame = () => {
    if (!activeGame) return;

    Alert.alert("Delete Active Game", "Are you sure you want to delete the active game?", [
      { text: "Cancel", style: "cancel" },
      {
        text: "Delete",
        style: "destructive",
        onPress: () => {
          if (typeof clearActiveGame === "function") {
            clearActiveGame();
          }
        },
      },
    ]);
  };

  const navItems = [
    { label: "Stats", sub: "Metrics and breakdowns", route: "/stats" },
    { label: "ELO", sub: "Form, skills, context", route: "/elo" },
    { label: "History", sub: "Past sessions and exports", route: "/history" },
    { label: "Charts", sub: "Visual trends", route: "/charts" },
    { label: "Compare", sub: "Player and group compare", route: "/charts/compare" },
    { label: "Player Cards", sub: "Card browser", route: "/ColorPlayerCard" },
    { label: "Definitions", sub: "Metric glossary", route: "/definitions" },
    { label: "Manage", sub: "Players and groups", route: "/manage-players-groups" },
  ];

  
// ===== START GAME STATE =====
const canStartGame =
  (selectedPlayers?.length ?? 0) >= 2 ||
  Boolean(selectedGroupId);


    <SafeAreaView style={styles.container}>
      <View style={styles.backgroundLayer}>
        <StarryNight />
        <View style={styles.backgroundDim} />
      </View>

      <View style={styles.screenShell}>
        <View style={styles.headerCard}>
          <View style={styles.headerTextWrap}>
            <Text style={styles.kicker}>Moonrakers</Text>
            <Text style={styles.title}>Home</Text>
            <Text style={styles.subtitle}>
              Game setup, rankings, and navigation.
            </Text>
          </View>

          <View style={styles.headerBadge}>
            <Text style={styles.headerBadgeText}>LIVE</Text>
