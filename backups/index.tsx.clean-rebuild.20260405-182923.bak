  blue: "#3B82F6",
  blueSoft: "rgba(59,130,246,0.18)",
  green: "#22C55E",
  greenSoft: "rgba(34,197,94,0.16)",
  amber: "#F59E0B",
  amberSoft: "rgba(245,158,11,0.16)",
  red: "#EF4444",
