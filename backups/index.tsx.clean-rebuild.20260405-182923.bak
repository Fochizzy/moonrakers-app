      }}
    >
      <ColorPlayerCard
        player={player}
        size="large"
        showInitial
      />
    </TouchableOpacity>
  );
})}
                            </Text>
                          </View>
                        </Pressable>
                      );
                    })
                  )}

                  {rankedPlayers.length > 10 ? (
                    <Pressable
                      onPress={() => setShowAllLeaderboard((current) => !current)}
                      style={styles.showMoreButton}
                    >
                      <Text style={styles.showMoreButtonText}>
                        {showAllLeaderboard ? "Show Top 10" : "Show All"}
                      </Text>
                    </Pressable>
                  ) : null}
                </ScrollView>
              </View>
            </View>
          ) : null}

          {activeTab === "Navigation" ? (
            <View style={styles.navigationPanel}>
              <View style={styles.navigationGrid}>
                {navItems.map((item) => {
                  const active = pathname === item.route;

                  
// ===== START GAME STATE =====
const canStartGame =
  (selectedPlayers?.length ?? 0) >= 2 ||
  Boolean(selectedGroupId);


                    <Pressable
                      key={item.route}
                      onPress={() => router.push(item.route as any)}
                      style={[styles.navigationTile, active && styles.navigationTileActive]}
                    >
                      <Text style={[styles.navigationTileTitle, active && styles.navigationTileTitleActive]}>
                        {item.label}
                      </Text>
                      <Text style={styles.navigationTileSub}>{item.sub}</Text>
                    </Pressable>
                  );
                })}
              </View>
            </View>
          ) : null}
        </View>
      </View>
    </SafeAreaView>
  );
}

