function PlayerIdentityCard({
  player,
  size = "medium",
  selected = false,
  showName = true,
}: {
  player: PlayerLike;
  size?: "small" | "medium" | "large";
  selected?: boolean;
  showName?: boolean;
}) {
  const accent = getPlayerColor(player.color);
  const artIndex =
    typeof player.assignedCardArtIndex === "number" && Number.isFinite(player.assignedCardArtIndex)
      ? player.assignedCardArtIndex
      : 0;

  const cardWidth = size === "small" ? 42 : size === "medium" ? 54 : PLAYER_CARD_WIDTH;
  const cardHeight = size === "small" ? 60 : size === "medium" ? 76 : PLAYER_CARD_HEIGHT;

  
// ===== START GAME STATE =====
const canStartGame =
  (selectedPlayers?.length ?? 0) >= 2 ||
  Boolean(selectedGroupId);


    <View style={showName ? styles.identityCardWrap : undefined}>
      <View
        style={[
          styles.identityCardShell,
          {
            width: cardWidth,
            height: cardHeight,
            borderColor: selected ? accent : `${accent}55`,
            shadowColor: accent,
          },
          selected && styles.identityCardShellActive,
        ]}
      >
        <CropCardArt artIndex={artIndex} width={cardWidth - 4} height={cardHeight - 4} />
        <View style={styles.cardDim} />

        <View style={[styles.initialsBadge, { borderColor: accent }]}>
          <Text style={styles.initialsText}>
            {player.initials || getPlayerInitials(player.name)}
          </Text>
        </View>

        {showName ? (
          <View style={[styles.bottomLabel, { borderColor: accent }]}>
            <Text numberOfLines={2} style={styles.bottomLabelText}>
              {player.name}
            </Text>
          </View>
        ) : null}
      </View>
    </View>
  );
}

function GroupPreviewRow({
  group,
  players,
  selected,
  onPress,
}: {
  group: GroupLike;
  players: PlayerLike[];
  selected: boolean;
  onPress: () => void;
}) {
  const groupPlayers = players.filter((player) =>
    Array.isArray(group.playerIds) ? group.playerIds.includes(player.id) : false
  );

  
// ===== START GAME STATE =====
const canStartGame =
