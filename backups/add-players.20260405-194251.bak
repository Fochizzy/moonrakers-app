    borderColor: 'rgba(139, 92, 246, 0.30)',
  },

  backButtonText: {
    color: '#DDD6FE',
    fontSize: 12,
    fontWeight: '800',
  },

  titleBlock: {
    flex: 1,
    minWidth: 0,
  },

  title: {
    color: THEME.textPrimary,
    fontSize: 17,
    fontWeight: '900',
