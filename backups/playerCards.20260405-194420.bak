import { CardColor, getCardsByColor } from "@/playerCardCatalog";

export function normalizeCardColor(color?: string): CardColor | null {
  switch ((color ?? "").toLowerCase()) {
    case "blue":
    case "green":
    case "purple":
    case "orange":
    case "yellow":
      return (color ?? "").toLowerCase() as CardColor;
    default:
      return null;
  }
}

export function pickRandomCardArtIndexForColor(color?: string): number | null {
  const normalized = normalizeCardColor(color);
  if (!normalized) return null;

  const cards = getCardsByColor(normalized);
  if (!cards.length) return null;

  const chosen = cards[Math.floor(Math.random() * cards.length)];
  return typeof chosen?.artIndex === "number" ? chosen.artIndex : null;
}
