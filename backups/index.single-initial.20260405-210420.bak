  },

  card: {
    width: "48.3%",
    minHeight: 150,
    borderRadius: 20,
    padding: 12,
    backgroundColor: "rgba(15, 23, 42, 0.92)",
    borderWidth: 1,
    overflow: "hidden",
    gap: 10,
  },

  cardGlow: {
    position: "absolute",
    top: -20,
    right: -20,
    width: 90,
    height: 90,
    borderRadius: 999,
  },

  cardImageWrap: {
    width: 72,
    height: 102,
    borderRadius: 12,
    overflow: "hidden",
    borderWidth: 2,
    borderColor: "rgba(255,255,255,0.08)",
    backgroundColor: "#0f172a",
  },

  cardDim: {
    ...StyleSheet.absoluteFillObject,
    backgroundColor: "rgba(0,0,0,0.15)",
  },

  initialsBadge: {
    position: "absolute",
    top: 4,
    left: 4,
    minWidth: 26,
    height: 26,
