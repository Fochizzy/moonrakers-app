import React, { useMemo } from "react";
import {
  Pressable,
  ScrollView,
  StyleSheet,
  View,
  Image,
} from "react-native";
import { useRouter } from "expo-router";

import { useStore } from "@/store/useStore";
import StarryNight from "@/components/ui/StarryNight";
import Text from "@/components/ui/Text";

const SHEET = require("@/assets/images/player-card-sheet.png");

const SHEET_COLUMNS = 5;
const SHEET_ROWS = 6;

type Player = {
  id: string;
  name?: string;
  initials?: string;
  color?: string;
  assignedCardArtIndex?: number | null;
};

function cropPosition(index: number) {
  return {
    row: Math.floor(index / SHEET_COLUMNS),
    col: index % SHEET_COLUMNS,
  };
}

function CropCard({
  index,
  width,
  height,
}: {
  index: number;
  width: number;
  height: number;
}) {
  const { row, col } = cropPosition(index);

  return (
    <View style={{ width, height, overflow: "hidden", borderRadius: 12 }}>
      <Image
        source={SHEET}
        resizeMode="stretch"
        style={{
          position: "absolute",
          width: width * SHEET_COLUMNS,
          height: height * SHEET_ROWS,
          left: -(col * width),
          top: -(row * height),
        }}
      />
    </View>
  );
}

export default function PlayerIndexScreen() {
  const router = useRouter();

  const rawPlayers = useStore((s: any) => s.players);

  const players = useMemo<Player[]>(
    () =>
      (Array.isArray(rawPlayers) ? rawPlayers : [])
        .filter((p: any) => p?.id)
        .sort((a: any, b: any) =>
          String(a?.name ?? "").localeCompare(String(b?.name ?? ""))
        ),
    [rawPlayers]
  );

  return (
    <View style={styles.root}>
      <View style={styles.backgroundLayer}>
        <StarryNight />
        <View style={styles.backgroundGlowA} />
        <View style={styles.backgroundGlowB} />
      </View>

      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.heroCard}>
          <Text style={styles.title}>Select Players</Text>
          <Text style={styles.subtitle}>
            Tap a player card to open their profile
          </Text>
        </View>

        <View style={styles.grid}>
          {players.map((player) => {
            const artIndex =
              typeof player.assignedCardArtIndex === "number"
                ? player.assignedCardArtIndex
                : 0;

            const accent = player.color || "#67E8F9";

            return (
              <Pressable
                key={player.id}
                onPress={() =>
                  router.push({
                    pathname: "/player-profile/[playerId]",
                    params: { playerId: player.id },
                  })
                }
                style={[styles.card, { borderColor: `${accent}66` }]}
              >
                <View
                  style={[styles.cardGlow, { backgroundColor: `${accent}22` }]}
                />

                <View style={styles.cardImageWrap}>
                  <CropCard index={artIndex} width={72} height={102} />

                  <View style={styles.cardDim} />

                  <View
                    style={[styles.initialsBadge, { borderColor: accent }]}
                  >
                    <Text style={styles.initialsText}>
                      {(player.name?.trim()?.[0] ?? "?").toUpperCase()}
                    </Text>
                  </View>
                </View>

                <Text style={styles.cardName} numberOfLines={2}>
                  {player.name ?? "Unknown Player"}
                </Text>

                <Text style={[styles.cardMeta, { color: accent }]}>
                  Open Profile
                </Text>
              </Pressable>
            );
          })}
        </View>

        {players.length === 0 ? (
          <View style={styles.emptyCard}>
            <Text style={styles.emptyTitle}>No players found</Text>
            <Text style={styles.emptyText}>
              Add players or import a backup.
            </Text>
          </View>
        ) : null}
      </ScrollView>
    </View>
  );
}

