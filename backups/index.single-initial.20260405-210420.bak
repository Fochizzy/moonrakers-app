  root: {
    flex: 1,
    backgroundColor: "#040814",
  },

  backgroundLayer: {
    ...StyleSheet.absoluteFillObject,
  },

  backgroundGlowA: {
    position: "absolute",
    top: -70,
    left: -20,
    width: 220,
    height: 220,
    borderRadius: 999,
    backgroundColor: "rgba(103, 232, 249, 0.18)",
  },

  backgroundGlowB: {
    position: "absolute",
    bottom: -90,
    right: -20,
    width: 240,
    height: 240,
    borderRadius: 999,
    backgroundColor: "rgba(251, 191, 36, 0.14)",
  },

  content: {
    paddingHorizontal: 14,
    paddingTop: 14,
    paddingBottom: 24,
    gap: 12,
  },

  heroCard: {
    backgroundColor: "rgba(10, 20, 40, 0.88)",
