import React from 'react';
import { ScrollView, StyleSheet, View } from 'react-native';
import { useLocalSearchParams } from 'expo-router';
import Text from '@/components/ui/Text';
import StarryNight from '@/components/ui/StarryNight';
import { METRIC_MAP, type MetricCategory, type MetricDefinition } from '@/utils/metricMap';

const SECTION_ORDER: MetricCategory[] = [
  'Core',
  'Support',
  'Efficiency',
  'Execution',
  'Pressure',
  'Outcome',
  'Position',
  'Conversion',
  'Tempo',
  'Style',
  'Derived',
];

const SECTION_TITLES: Record<MetricCategory, string> = {
  Core: 'Core',
  Support: 'Support',
  Efficiency: 'Efficiency',
  Execution: 'Execution',
  Pressure: 'Pressure and Consistency',
  Outcome: 'Outcome',
  Position: 'Position',
  Conversion: 'Conversion',
  Tempo: 'Tempo',
  Style: 'Style',
  Derived: 'Derived',
  Elo: 'ELO',
  Projection: 'Projection',
  Context: 'Context',
};

function getFormula(item: MetricDefinition) {
  return item.formula ?? 'Formula not documented yet';
}

function getMeaning(item: MetricDefinition) {
  return item.meaning ?? item.description;
}

function DefinitionCard({
  item,
  selected,
}: {
  item: MetricDefinition;
  selected: boolean;
}) {
  return (
    <View style={[styles.card, selected && styles.cardSelected]}>
      <Text style={styles.metricName}>{item.label}</Text>
      <Text style={styles.label}>Formula</Text>
      <Text style={styles.formula}>{getFormula(item)}</Text>
      <Text style={styles.label}>Meaning</Text>
      <Text style={styles.meaning}>{getMeaning(item)}</Text>
    </View>
  );
}

export default function DefinitionsScreen() {
  const params = useLocalSearchParams<{ metric?: string | string[] }>();
  const selectedMetric = Array.isArray(params.metric) ? params.metric[0] : params.metric;

  const visibleMetrics = Object.values(METRIC_MAP).filter(
    (item) => item.formula || item.meaning || item.description
  );

  const sections = SECTION_ORDER
    .map((category) => ({
      category,
      title: SECTION_TITLES[category],
      items: visibleMetrics.filter((item) => item.category === category),
    }))
    .filter((section) => section.items.length > 0);

  return (
    <View style={styles.root}>
      <View style={styles.backgroundLayer}>
        <StarryNight />
        <View style={styles.backgroundDim} />
      </View>

      <ScrollView contentContainerStyle={styles.content} showsVerticalScrollIndicator={false}>
        <Text style={styles.title}>Metric Definitions</Text>
        <Text style={styles.subtitle}>
          Tap the ? icon on any stat to jump here and see the formula plus a plain-English meaning.
        </Text>

        {sections.map((section) => (
          <View key={section.category} style={styles.section}>
            <Text style={styles.sectionTitle}>{section.title}</Text>
            {section.items.map((item) => (
              <DefinitionCard
                key={item.key}
                item={item}
                selected={selectedMetric === item.key}
              />
            ))}
          </View>
        ))}
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
  root: {
    flex: 1,
    backgroundColor: '#050814',
  },
  backgroundLayer: {
    ...StyleSheet.absoluteFillObject,
  },
  backgroundDim: {
    ...StyleSheet.absoluteFillObject,
    backgroundColor: 'rgba(0,0,0,0.20)',
  },
  content: {
    padding: 16,
    paddingBottom: 28,
    gap: 16,
  },
  title: {
    color: '#FFFFFF',
    fontSize: 28,
    fontWeight: '900',
  },
  subtitle: {
    color: '#CBD5E1',
    fontSize: 13,
    lineHeight: 18,
  },
  section: {
    gap: 10,
  },
  sectionTitle: {
    color: '#A5B4FC',
    fontSize: 18,
    fontWeight: '900',
    marginTop: 8,
  },
  card: {
    borderRadius: 16,
    padding: 14,
    backgroundColor: 'rgba(16, 26, 43, 0.94)',
    borderWidth: 1,
    borderColor: 'rgba(148,163,184,0.14)',
    gap: 6,
  },
  cardSelected: {
    borderColor: 'rgba(168,85,247,0.65)',
    backgroundColor: 'rgba(35, 22, 56, 0.92)',
  },
  metricName: {
    color: '#FFFFFF',
    fontSize: 16,
    fontWeight: '900',
  },
  label: {
    color: '#8EA6C8',
    fontSize: 11,
    fontWeight: '700',
    textTransform: 'uppercase',
    letterSpacing: 0.6,
    marginTop: 4,
  },
  formula: {
    color: '#E9D5FF',
    fontSize: 13,
    fontWeight: '700',
  },
  meaning: {
    color: '#F8FAFC',
    fontSize: 13,
    lineHeight: 18,
  },
});






