{
  "name": "moonrakers-app",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "validate:assets": "node scripts/validate-assets.js",
    "start": "npm run validate:assets && expo start",
    "dashboard:dev": "npm run dev --workspace @moonrakers/dashboard",
    "dashboard:preview": "npm run preview --workspace @moonrakers/dashboard",
    "dashboard:build": "npm run build --workspace @moonrakers/dashboard",
    "dashboard:deploy": "npm run deploy --workspace @moonrakers/dashboard",
    "dashboard:cf-typegen": "npm run cf-typegen --workspace @moonrakers/dashboard",
    "dashboard:typecheck": "npm run typecheck --workspace @moonrakers/dashboard",
    "dashboard:test": "npm run test --workspace @moonrakers/dashboard",
    "dashboard:e2e": "npm run e2e --workspace @moonrakers/dashboard",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "node scripts/run-focused-lint.cjs",
    "lint:all": "eslint . --ext .js,.cjs,.ts,.tsx",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck --incremental false",
    "test": "node scripts/run-all-tests.cjs",
    "test:analytics": "node scripts/run-focused-suite.cjs analytics && node scripts/shared-cloud-rehydration-callers.test.cjs",
    "test:ui": "node scripts/run-focused-suite.cjs ui",
    "test:critical-path": "node scripts/critical-path-smoke.test.cjs",
    "verify": "npm run typecheck && npm run test",
    "release:patch": "npm version patch --no-git-tag-version",
    "build:android:prod": "eas build -p android --profile production",
    "update:preview": "eas update --channel preview --environment preview --non-interactive",
    "update:production": "eas update --channel production --environment production --non-interactive",
    "release:android": "npm run release:patch && eas build -p android --profile production --auto-submit-with-profile production --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "^2.104.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.7",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "papaparse": "^5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "supabase": "^2.101.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
