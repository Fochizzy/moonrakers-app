{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-07-04",

  // Assets-only Worker: there is no "main", so Cloudflare serves ./public
  // straight off the edge. No build step, no runtime, no cold starts.
  // Unmatched paths get the nearest 404.html rather than a soft 404.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  // Cloudflare creates the DNS record and edge certificate for each hostname on
  // deploy. Both are custom domains rather than one plus a redirect, so the apex
  // and www each serve the site directly with no extra rule to maintain.
  // Requires the izzyhodnett.com zone to be active in the account.
  "routes": [
    { "pattern": "izzyhodnett.com", "custom_domain": true },
    { "pattern": "www.izzyhodnett.com", "custom_domain": true }
  ],

  // Declaring routes makes wrangler default workers_dev to false, which would
  // take portfolio.<subdomain>.workers.dev offline. Keep it as a fallback.
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
