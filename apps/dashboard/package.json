{
  "name": "@moonrakers/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preview": "opennextjs-cloudflare build && node ./scripts/repair-opennext-worker.mjs && opennextjs-cloudflare preview",
    "build": "node ./scripts/prepare-dashboard-build.mjs && next build --webpack && node ./scripts/repair-opennext-standalone.mjs",
    "deploy": "opennextjs-cloudflare build && node ./scripts/repair-opennext-worker.mjs && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.104.0",
    "clsx": "^2.1.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.5",
    "recharts": "^3.9.2",
    "wrangler": "^4.107.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
